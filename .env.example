# Copy this file to .env and fill in your real values.
# Never commit your actual .env file (it's already in .gitignore).

PORT=3000
NODE_ENV=production
CLIENT_URL=https://your-live-url.onrender.com

# Comma-separated list of origins allowed to call this API.
# Include your live frontend URL(s). No spaces needed around commas.
ALLOWED_ORIGINS=https://your-live-url.onrender.com

# --- Contact form (Gmail SMTP via nodemailer) ---
# Generate an "app password" at https://myaccount.google.com/apppasswords
# (regular Gmail password will NOT work)
CONTACT_EMAIL_USER=youraddress@gmail.com
CONTACT_EMAIL_PASS=your16charapppassword
CONTACT_EMAIL_TO=youraddress@gmail.com

# --- CAPTCHA (Cloudflare Turnstile) ---
# Get both keys free at https://dash.cloudflare.com/?to=/:account/turnstile
# TURNSTILE_SITE_KEY is public and goes in the frontend HTML.
# TURNSTILE_SECRET_KEY is private and stays server-side only.
TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here

# --- Payments (Stripe) ---
# Get this from https://dashboard.stripe.com/apikeys — use a test key
# (starts with sk_test_) until you're ready to go live
STRIPE_SECRET_KEY=sk_test_yourkeyhere
