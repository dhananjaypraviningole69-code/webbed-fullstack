# Copy this file to .env and fill in real values.
# `npm run start:all` does this copy for you automatically on first run.

PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the API. Leave empty
# for local dev (falls open); set this before deploying anywhere real.
ALLOWED_ORIGINS=http://localhost:3000

# --- Contact form (Gmail SMTP via nodemailer) ---
# Generate an "app password" at https://myaccount.google.com/apppasswords
CONTACT_EMAIL_USER=youraddress@gmail.com
CONTACT_EMAIL_PASS=your16charapppassword
CONTACT_EMAIL_TO=youraddress@gmail.com

# --- CAPTCHA (Cloudflare Turnstile) ---
# Free at https://dash.cloudflare.com/?to=/:account/turnstile
# Site key also needs pasting into public/index.html and public/admin.html
# (search for YOUR_TURNSTILE_SITE_KEY in each).
TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_CURRENCY=INR

# --- Admin panel ---
ADMIN_USERNAME=youradminname
# Generate with: node -e "const b=require('bcrypt'); b.hash('YOUR_PASSWORD',12).then(console.log)"
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=
# Generate with: node -e "const {authenticator}=require('otplib'); console.log(authenticator.generateSecret())"
ADMIN_TOTP_SECRET=
